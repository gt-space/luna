# Settings run.sh reads. Check them before every bench session.

# Engine controller IP:port. PROVISIONAL: 192.168.1.138 is the expected CTV
# EC address (.137 is servo's), not yet confirmed by the EC firmware owners.
# flight2's own default (common EC_ADDRESS) is still 192.168.1.50.
# Use 127.0.0.1:8378 for fake_ec.
FC_EC_ADDRESS=192.168.1.138:8378
