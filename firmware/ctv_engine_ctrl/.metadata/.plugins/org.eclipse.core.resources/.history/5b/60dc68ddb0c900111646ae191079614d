/**
  * @brief  The application entry point.
  * @retval int
  */
int main(void)
{

  /* USER CODE BEGIN 1 */

  /* USER CODE END 1 */
/* USER CODE BEGIN Boot_Mode_Sequence_0 */
#if defined(DUAL_CORE_BOOT_SYNC_SEQUENCE)
  int32_t timeout;
#endif /* DUAL_CORE_BOOT_SYNC_SEQUENCE */
/* USER CODE END Boot_Mode_Sequence_0 */

  /* MPU Configuration--------------------------------------------------------*/
  MPU_Config();

/* USER CODE BEGIN Boot_Mode_Sequence_1 */
#if defined(DUAL_CORE_BOOT_SYNC_SEQUENCE)
  /* Wait until CPU2 boots and enters in stop mode or timeout*/
  timeout = 0xFFFF;
  while((__HAL_RCC_GET_FLAG(RCC_FLAG_D2CKRDY) != RESET) && (timeout-- > 0));
  if ( timeout < 0 )
  {
  Error_Handler();
  }
#endif /* DUAL_CORE_BOOT_SYNC_SEQUENCE */
/* USER CODE END Boot_Mode_Sequence_1 */
  /* MCU Configuration--------------------------------------------------------*/

  /* Reset of all peripherals, Initializes the Flash interface and the Systick. */
  HAL_Init();

  /* USER CODE BEGIN Init */

  /* USER CODE END Init */

  /* Configure the system clock */
  SystemClock_Config();
/* USER CODE BEGIN Boot_Mode_Sequence_2 */
#if defined(DUAL_CORE_BOOT_SYNC_SEQUENCE)
/* When system initialization is finished, Cortex-M7 will release Cortex-M4 by means of
HSEM notification */
/*HW semaphore Clock enable*/
__HAL_RCC_HSEM_CLK_ENABLE();
/*Take HSEM */
HAL_HSEM_FastTake(HSEM_ID_0);
/*Release HSEM in order to notify the CPU2(CM4)*/
HAL_HSEM_Release(HSEM_ID_0,0);
/* wait until CPU2 wakes up from stop mode */
timeout = 0xFFFF;
while((__HAL_RCC_GET_FLAG(RCC_FLAG_D2CKRDY) == RESET) && (timeout-- > 0));
if ( timeout < 0 )
{
Error_Handler();
}
#endif /* DUAL_CORE_BOOT_SYNC_SEQUENCE */
/* USER CODE END Boot_Mode_Sequence_2 */

  /* USER CODE BEGIN SysInit */

  /* USER CODE END SysInit */

  /* Initialize all configured peripherals */
  MX_GPIO_Init();
  MX_CRC_Init();
  MX_ETH_Init();
  MX_ADC3_Init();
  MX_I2C3_SMBUS_Init();
  MX_IWDG1_Init();
  MX_UART5_Init();
  MX_UART7_Init();
  MX_TIM2_Init();
  /* USER CODE BEGIN 2 */

  HAL_IWDG_Refresh(&hiwdg1);

  /* PWM on TIM2 CH1 */
  HAL_TIM_PWM_Start(&htim2, TIM_CHANNEL_1);

  /* ADC3 ch0 */
  HAL_ADCEx_Calibration_Start(&hadc3, ADC_CALIB_OFFSET, ADC_SINGLE_ENDED);
  HAL_ADC_Start(&hadc3);
  if (HAL_ADC_PollForConversion(&hadc3, 10) == HAL_OK)
  {
    char b[40];
  }

  /* UART7 check: wire UART5 TX -> UART7 RX (and ideally 7 TX -> 5 RX) */
  {
    const char *msg = "UART7";
    int ok = 1;
    for (size_t i = 0; i < strlen(msg); i++)
    {
      uint8_t rx = 0;
      HAL_UART_Transmit(&huart5, (uint8_t *)&msg[i], 1, 10);
      if (HAL_UART_Receive(&huart7, &rx, 1, 10) != HAL_OK || rx != msg[i]) ok = 0;
    }
  }

  /* I2C3 bus scan */
  for (uint16_t a = 1; a < 128; a++)
  {
    HAL_IWDG_Refresh(&hiwdg1);
    if (HAL_SMBUS_IsDeviceReady(&hsmbus3, a << 1, 1, 5) == HAL_OK)
    {
      char b[32];
    }
  }

  /* Ethernet: start MAC/DMA and build a raw broadcast frame */
  HAL_ETH_Start(&heth);
  memset(eth_frame, 0, sizeof eth_frame);
  memset(&eth_frame[0], 0xFF, 6);                         // dst: broadcast
  memcpy(&eth_frame[6], heth.Init.MACAddr, 6);            // src
  eth_frame[12] = 0x88; eth_frame[13] = 0xB5;             // local experimental ethertype
  memcpy(&eth_frame[14], "hello from board", 16);
  eth_buf.buffer = eth_frame;
  eth_buf.len    = sizeof eth_frame;
  eth_buf.next   = NULL;
  TxConfig.Length   = sizeof eth_frame;
  TxConfig.TxBuffer = &eth_buf;
  /* USER CODE END 2 */

  /* Infinite loop */
  /* USER CODE BEGIN WHILE */
  while (1)
  {
    /* USER CODE END WHILE */
	  HAL_IWDG_Refresh(&hiwdg1);

	  /* Enable pins HIGH (motor enables on PD, actuator dir on PB) */
	  HAL_GPIO_WritePin(GPIOD, m1_en_Pin|m2_en_Pin|m3_en_Pin|m4_en_Pin, GPIO_PIN_SET);
	  HAL_GPIO_WritePin(GPIOB, Actuator_data_dir_a1_Pin|Actuator_data_dir_a2_Pin, GPIO_PIN_SET);
	  WD_Delay(500);

	  HAL_GPIO_WritePin(GPIOD, m1_en_Pin|m2_en_Pin|m3_en_Pin|m4_en_Pin, GPIO_PIN_RESET);
	  HAL_GPIO_WritePin(GPIOB, Actuator_data_dir_a1_Pin|Actuator_data_dir_a2_Pin, GPIO_PIN_RESET);
	  WD_Delay(500);

	  /* Ethernet: link pin + send a frame (check with Wireshark on the other end) */
	  say(HAL_GPIO_ReadPin(Eth_LINK_ST_GPIO_Port, Eth_LINK_ST_Pin) ? "link: HIGH\r\n" : "link: LOW\r\n");
	  HAL_ETH_Transmit(&heth, &TxConfig, 50);
    /* USER CODE BEGIN 3 */
  }
  /* USER CODE END 3 */
}

